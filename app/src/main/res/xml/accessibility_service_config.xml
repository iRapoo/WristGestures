<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service capabilities:
    - canPerformGestures:        emulate swipes (e.g. swipe up on the watch face to open notifications);
    - canRetrieveWindowContent:  find the scrollable list on screen and scroll it precisely.
    The service does not subscribe to any events it does not need, so it does not
    read notification texts or anything else from the screen in the background.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="200"
    android:settingsActivity="xyz.quenix.wristgestures.ui.MainActivity" />
